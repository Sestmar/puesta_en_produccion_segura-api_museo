# Plantilla de configuración de las pruebas E2E y de estrés.
# Copia este fichero a tests_e2e/.env.local o tests_e2e/.env.prod (ignorados por
# git) y rellénalo. Se carga solo según E2E_TARGET (local | prod).
# En local, `python -m tests_e2e.setup_local` genera .env.local automáticamente.

E2E_TARGET=prod
E2E_BASE_URL=https://museo.example.org
E2E_API_URL=https://museo-api.example.org

# Cuentas de prueba dedicadas (nunca las cuentas personales).
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=
E2E_CLIENT_USER=
E2E_CLIENT_PASSWORD=

# En producción, por defecto, ni se escribe ni se crean cuentas.
E2E_ALLOW_WRITES=0
E2E_ALLOW_SIGNUP=0

# Usuarios de carga de Locust: <prefijo>01 … <prefijo>NN, misma contraseña.
# La cuenta NN se reserva como víctima del escenario de fuerza bruta.
LOAD_USER_PREFIX=loadtest-
LOAD_USER_COUNT=
LOAD_USER_PASSWORD=
LOAD_ALLOW_WRITES=0
