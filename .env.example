# Copy this file to .env and adjust the values before running.
# Never commit the real .env file.

ENVIRONMENT=development
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Credentials used by docker-compose for PostgreSQL. Change them.
POSTGRES_USER=museum
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=museum

# OAuth con Google (inicio de sesión con cuenta de Google). Deja GOOGLE_CLIENT_ID
# y GOOGLE_CLIENT_SECRET vacíos para desactivar el botón; la API responde 503.
# Crea las credenciales en https://console.cloud.google.com (APIs y servicios >
# Credenciales > ID de cliente OAuth) y autoriza exactamente esta redirect URI.
#
# IMPORTANTE: GOOGLE_REDIRECT_URI, FRONTEND_URL y VITE_API_URL deben usar el
# MISMO host (localhost). La cookie httpOnly del refresh token está ligada al
# host y el navegador no la comparte entre localhost y 127.0.0.1.
#
# Docker Compose publica la API en el puerto 8001:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
# Con uvicorn local (puerto 8000) usa, en su lugar:
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# A dónde vuelve el navegador tras el callback (con ?oauth=success|error).
FRONTEND_URL=http://localhost:5173

# Local development without Docker (SQLite):
DATABASE_URL=sqlite:///./museo.db
# Local development against the Docker Postgres (exposed on localhost:5432):
# DATABASE_URL=postgresql+psycopg://museum:museum@localhost:5432/museum
# Inside docker-compose the host is the service name "db" (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://museum:museum@db:5432/museum

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
LOGIN_RATE_LIMIT=5 per minute
REFRESH_RATE_LIMIT=20 per minute
SIGNUP_RATE_LIMIT=10 per hour
OAUTH_RATE_LIMIT=20 per minute
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_SESSIONS_PER_USER=10
DEFAULT_RATE_LIMIT=100 per minute
BCRYPT_ROUNDS=12
LOG_LEVEL=INFO

# Retention (run "python -m app.retention" periodically).
# Delete sessions expired/revoked more than N days ago:
SESSION_RETENTION_DAYS=7
# Delete audit entries older than N days (0 = keep forever). Pruning moves the
# chain genesis forward and records a signed checkpoint so /audit/verify keeps
# working:
AUDIT_RETENTION_DAYS=0

# Rate-limit storage. Defaults to in-memory (per process). For multi-worker or
# multi-replica deployments use a shared store, e.g. Redis:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# (Redis storage requires the "redis" package: pip install 'limits[redis]')
#
# Reverse-proxy IPs whose X-Forwarded-For header is trusted for client IP
# resolution. Leave empty when there is no proxy in front of the API.
# TRUSTED_PROXIES=["10.0.0.1"]
#
# Redirect plain HTTP requests to HTTPS (307). Enable only when a TLS-terminating
# proxy sits in front and forwards X-Forwarded-Proto.
# Refresh-token cookie settings. This example runs over plain HTTP, so Secure is
# disabled; set REFRESH_COOKIE_SECURE=true behind HTTPS in production.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

FORCE_HTTPS=false
#
# Content-Security-Policy header sent on every response. Set empty to disable.
# The strict default blocks the interactive docs UI; loosen it only if you serve
# Swagger UI in an environment where the docs are reachable.
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
#
# External audit-chain anchor. When set, the audit head is appended to this file
# after every event, so truncation of the audit tail (undetectable by the hash
# chain alone) is caught by GET /audit/verify. Point it to a location separate
# from the database (own volume / permissions). Leave empty to disable.
# Relative to the working directory: in Docker it resolves to the writable
# /app/audit_anchor volume; locally it creates ./audit_anchor/.
AUDIT_ANCHOR_PATH=./audit_anchor/anchor.log

# SQLAlchemy connection pool (PostgreSQL only; ignored for SQLite).
# pool_pre_ping drops dead connections before reuse; recycle keeps connections
# below the server-side idle timeout (default 1800s = 30 min).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
