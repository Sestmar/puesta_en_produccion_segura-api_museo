# URL base de la API FastAPI (backend).
# Usa SIEMPRE el mismo host que GOOGLE_REDIRECT_URI y FRONTEND_URL del backend:
# la cookie httpOnly del refresh token está ligada al host y no se comparte
# entre localhost y 127.0.0.1.
# - uvicorn local (puerto 8000):
VITE_API_URL=http://localhost:8000
# - Docker Compose (API publicada en el puerto 8001):
# VITE_API_URL=http://localhost:8001
